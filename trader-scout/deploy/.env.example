# Runtime setup copies this template to deploy/.env with mode 0600. Use a
# random hexadecimal DB password so it is safe in the PostgreSQL URL.
SCOUT_DEVTRACKER_DB_PASSWORD=replace_with_64_hex_characters
SCOUT_POSTGRES_VOLUME=trader-scout-devtracker-choose-a-unique-name
SCOUT_RUNTIME_CONFIG_PATH=./config/dev-tracker.toml
SCOUT_RUNTIME_EXPORTS_PATH=./exports
# Add only the providers and notifications you explicitly enable.
SCOUT_SOLANA_RPC_URL=
SCOUT_SOLANA_FALLBACK_RPC_URL=
SCOUT_BSC_RPC_URL=
SCOUT_BSC_FALLBACK_RPC_URL=
SCOUT_BSC_LOGS_RPC_URL=
SCOUT_BSC_LOGS_MAX_SPAN=
SCOUT_BASE_RPC_URL=
SCOUT_BASE_FALLBACK_RPC_URL=
SCOUT_BASE_LOGS_RPC_URL=
SCOUT_BASE_LOGS_MAX_SPAN=
SCOUT_ROBINHOOD_RPC_URL=
SCOUT_ROBINHOOD_FALLBACK_RPC_URL=
SCOUT_ROBINHOOD_LOGS_RPC_URL=
SCOUT_ROBINHOOD_LOGS_MAX_SPAN=
SCOUT_HELIUS_API_KEY=
SCOUT_CODEX_API_KEY=
SCOUT_TELEGRAM_BOT_TOKEN=
SCOUT_TELEGRAM_CHAT_ID=
# Optional external liveness notification.
SCOUT_HEARTBEAT_URL=
# Used only by the corresponding explicit backfill CLI commands.
SCOUT_SOLANA_TRACKER_API_KEY=
SCOUT_BIRDEYE_API_KEY=
