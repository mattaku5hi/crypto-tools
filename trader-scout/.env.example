# trader-scout configuration template. Copy to `.env` and fill in; `.env` is
# gitignored. Values are secrets (keys inside URLs): never commit or print them.

# Solana primary (Helius)
SCOUT_HELIUS_API_KEY=
# Robinhood wallet listings (Blockscout PRO)
SCOUT_BLOCKSCOUT_API_KEY=
# Codex API (candidate data source, under evaluation)
SCOUT_CODEX_API_KEY=

# EVM primary RPC per chain (Alchemy: one key, per-network URLs)
SCOUT_BASE_RPC_URL=
SCOUT_BSC_RPC_URL=
SCOUT_ROBINHOOD_RPC_URL=

# Optional uncapped eth_getLogs endpoint per chain
SCOUT_BASE_LOGS_RPC_URL=
SCOUT_BSC_LOGS_RPC_URL=
SCOUT_ROBINHOOD_LOGS_RPC_URL=

# Fallback RPC per chain (dRPC free plan): used automatically when the primary
# provider fails or is rate limited. Full per-network dRPC URL.
SCOUT_SOLANA_FALLBACK_RPC_URL=
SCOUT_BSC_FALLBACK_RPC_URL=
SCOUT_BASE_FALLBACK_RPC_URL=
SCOUT_ROBINHOOD_FALLBACK_RPC_URL=

# Dev tracker (bins/dev-tracker, docs/DEV-TRACKER.md): PostgreSQL URL and the
# Telegram bot that receives changed wallet lists (token from @BotFather; chat
# id of the target chat/channel).
SCOUT_DEVTRACKER_DATABASE_URL=
SCOUT_TELEGRAM_BOT_TOKEN=
SCOUT_TELEGRAM_CHAT_ID=

# Dead man's switch (healthchecks.io): the check's ping URL, e.g. https://hc-ping.com/<uuid>.
# The daemon pings it every minute; empty = off. A secret: anyone with it can ping.
SCOUT_HEARTBEAT_URL=
